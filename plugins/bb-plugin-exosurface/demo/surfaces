#!/usr/bin/env bash
# Exosurface surfaces demo launcher. The demo itself is demo/surfaces.ts (in the TypeScript gate); this keeps the
# command `demo/surfaces <scenario>` and the node flags its former `env -S` shebang passed.
set -euo pipefail
exec node --experimental-transform-types --no-warnings "$(dirname "${BASH_SOURCE[0]}")/surfaces.ts" "$@"
