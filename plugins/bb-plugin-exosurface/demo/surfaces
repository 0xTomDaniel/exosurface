  const results = () => { const file = f.piRuns()[0]?.sessionFile; return file ? readFileSync(file, 'utf8').trim().split('\n').map(l => JSON.parse(l)).filter(e => e.type === 'message' && e.message.role === 'toolResult' && e.message.toolName === 'update_exosurface').map(e => e.message) : []; };
  try {
    let raw = 0;
    for (const [i, [name, args]] of calls.entries()) {
      host.send('primary', `call: ${JSON.stringify(args)}`);
      await until(`the result of ${name}`, () => results().length === i + 1 && host.deltas('primary').filter(d => d.kind === 'turn.boundary').length === i + 1);
      const r = results()[i], text = r.content.map(c => c.text).join('');
