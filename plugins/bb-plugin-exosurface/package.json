{
  "name": "bb-plugin-exosurface",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
  },
  "scripts": {
    "check": "scripts/check",
    "test": "node --experimental-transform-types --test test/*.test.ts",
    "build": "bb plugin build && node build.mjs && node build-runtime.mjs",
    "build:owner": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "build:runtime": "node build-runtime.mjs"
  },
  "bb": {
    "name": "Exosurface",
    "description": "Existing primary Exo/OptChat and A2UI experience, consolidated; releaseReady remains false",
    "host": "./host.ts",
    "server": "./server.ts",
    "app": "./app.tsx",
    "branding": {
      "icon": "Bot"
    }
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.15",
    "zod": "4.6.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.12",
    "@earendil-works/pi-ai": "1.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "css-tree": "3.2.1",
    "jsdom": "30.1.3",
    "@asamuzakjp/css-color": "7.1.9"
  },
  "overrides": {
    "@get-bb/plugin-sdk": {
      "zod": "4.6.6"
    }
  }
}
