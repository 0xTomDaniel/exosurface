{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "legacy",
    "test",
    "demo/**/*.ts",
    "server.ts",
    "host.ts",
    "app.tsx",
    "build.mjs",
    "build-runtime.mjs",
    "scripts/**/*.mjs",
    "compat/**/*.ts",
    "compat/**/*.tsx",
    "compat/**/*.mjs",
    "compat/**/*.cjs",
    "compat/**/*.js"
  ]
}
