{
  "name": "exosurface-a2a-pi-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm ci && playwright install chromium",
    "start": "tsx src/start.ts",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:model": "tsx tests/model-proof.ts",
    "validate": "npm run check && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@a2ui/lit": "0.11.0",
    "@a2ui/web_core": "0.11.0",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "lit": "3.3.3",
    "typebox": "1.3.7",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
