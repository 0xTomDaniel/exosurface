{
  "name": "exosurface-ag-ui-pi-spike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx src/main.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:pi": "tsx src/pi-proof.ts",
    "setup": "npm ci && playwright install chromium",
    "format": "prettier --write src test *.ts *.json *.html README.md evidence/*.md",
    "format:check": "prettier --check src test *.ts *.json *.html README.md evidence/*.md",
    "probe:source-race": "tsx src/source-race-proof.ts"
  },
  "dependencies": {
    "@a2ui/lit": "0.11.0",
    "@a2ui/web_core": "0.11.0",
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@ag-ui/encoder": "0.0.59",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "eventsource-parser": "3.0.6",
    "lit": "3.3.3",
    "rxjs": "7.8.1",
    "typebox": "1.3.7",
    "yaml": "2.9.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
