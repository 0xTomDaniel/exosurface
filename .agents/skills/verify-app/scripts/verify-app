#!/bin/sh
# verify-app: drive the Exo plugin's offline run surface (demo/surfaces) the way a user does and keep the proof (../SKILL.md).
# Usage: verify-app setup|launch|doctor|drive <feature>|cleanup|run
# Glue only: the helper is verify-app.ts beside this file, which node runs directly (type stripping, no build);
# it reads qc.toml with python3's tomllib (mise.toml pins python), which the helper names when it is missing.
command -v node >/dev/null || { echo "verify-app: node not on PATH" >&2; exit 1; }
exec node --disable-warning=ExperimentalWarning "$(dirname "$0")/verify-app.ts" "$@"
